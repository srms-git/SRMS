PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGO_DB_NAME=test
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
# Vite default port; if 5173 is busy Vite may use 5174+ (localhost ports are allowed in dev).
FRONTEND_URL=http://localhost:5173
APP_NAME=Scholarship Records Management System
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Python PDF converter (Flask on port 5001 in dev)
PDF_CONVERTER_URL=http://127.0.0.1:5001
# Shared secret between Node API and Flask PDF service (recommended in production)
PDF_CONVERTER_INTERNAL_TOKEN=
# Set to true only for local development
FLASK_DEBUG=true
